<included>
    <appender name="TELEMETRY_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <threadName/>
                <loggerName/>
                <message/>
                <arguments/>
                <mdc/>
                <throwableClassName/>
                <throwableMessage/>
                <stackTrace useShortFormat="true"/>
            </providers>
        </encoder>
    </appender>
</included>
